{
  "name": "@ghosttykit/pi-paste",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Pi extension for pasting local or SSH-bridged GhosttyKit clipboard content",
  "keywords": ["pi-package", "ghosttykit", "paste", "ghostty"],
  "pi": {
    "extensions": ["./index.ts"]
  },
  "files": ["index.ts", "README.md"],
  "scripts": {
    "fmt": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run fmt && npm run lint && npm run typecheck"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3"
  }
}
