set shell := ["bash", "-euo", "pipefail", "-c"]

binary := "ghosttykitd"
install_dir := env_var_or_default("HOME", ".") + "/.local/bin"
codesign_identity := env_var_or_default("GHOSTTYKIT_CODESIGN_IDENTITY", "-")
codesign_identifier := "dev.ghosttykit.ghosttykitd"
entitlements := "ghosttykitd.entitlements"

_default:
    just --list

fmt:
    swiftformat Sources Package.swift

fmt-check:
    swiftformat Sources Package.swift --lint

lint:
    swiftlint lint --strict Sources

resolve:
    swift package resolve

typecheck:
    swift build

test:
    swift test --quiet

check: fmt lint test build

build:
    swift build -c release
    cp .build/release/{{binary}} {{binary}}
    just sign {{binary}}

install:
    mkdir -p {{install_dir}}
    swift build -c release
    cp .build/release/{{binary}} {{install_dir}}/{{binary}}
    just sign {{install_dir}}/{{binary}}

sign path:
    codesign --force --sign '{{codesign_identity}}' --identifier '{{codesign_identifier}}' --entitlements {{entitlements}} {{path}}
