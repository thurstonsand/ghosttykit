{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:biomeVersions",
    "helpers:pinGitHubActionDigests",
    ":configMigration",
    ":maintainLockFilesWeekly",
    "abandonments:recommended",
    ":enableVulnerabilityAlertsWithAdditionalLabel(security)"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "ignorePaths": ["sdk/lua/.github/workflows/**", "nvim/.github/workflows/**"],
  "customManagers": [
    {
      "description": "hk.pkl imports hk's Pkl schema and builtins from a release, which should match the hk pinned in mise.toml.",
      "customType": "regex",
      "managerFilePatterns": ["/^hk\\.pkl$/"],
      "matchStrings": ["download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/hk@\\d+\\.\\d+\\.\\d+#"],
      "autoReplaceStringTemplate": "download/v{{{newValue}}}/hk@{{{newValue}}}#",
      "depNameTemplate": "hk",
      "packageNameTemplate": "jdx/hk",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "dependencyDashboard": true,
  "timezone": "America/New_York",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "Go modules"
    },
    {
      "matchManagers": ["npm"],
      "groupName": "npm packages"
    },
    {
      "matchManagers": ["swift"],
      "groupName": "Swift packages"
    },
    {
      "matchManagers": ["mise"],
      "groupName": "mise tools"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["hk"],
      "groupName": "mise tools"
    },
    {
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "enabled": false
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["lua"],
      "allowedVersions": "<5.2"
    },
    {
      "description": "@types/node tracks the engines floor, not the newest DefinitelyTyped release or the Node that dev and CI run: types from a later major describe APIs the oldest supported Node lacks, and tsc believes them. Move the ceiling when the floor moves.",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25"
    },
    {
      "description": "Renovate supports only Node 24 (its engines say ^24.11), so the toolset its own tasks run in stays there while the repo moves on",
      "matchFileNames": ["mise.renovate.toml"],
      "matchPackageNames": ["node"],
      "allowedVersions": "<25"
    },
    {
      "description": "Pi's extension loader swaps in the typebox it bundles, so pi-paste pins that exact version by hand and realigns it when Pi moves.",
      "matchPackageNames": ["typebox"],
      "enabled": false
    },
    {
      "description": "pi-paste tracks Pi releases as they ship, so Pi skips the minimum release age that holds back everything else, and each update raises the package.json floor to the Pi it was built against.",
      "matchPackageNames": ["@earendil-works/**"],
      "minimumReleaseAge": null,
      "rangeStrategy": "bump"
    }
  ]
}
