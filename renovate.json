{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:biomeVersions",
    ":configMigration",
    ":maintainLockFilesWeekly",
    "abandonments:recommended",
    ":enableVulnerabilityAlertsWithAdditionalLabel(security)"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "ignorePaths": ["sdk/lua/.github/workflows/**", "nvim/.github/workflows/**"],
  "dependencyDashboard": true,
  "timezone": "America/New_York",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "Go modules"
    },
    {
      "matchManagers": ["npm"],
      "groupName": "npm packages"
    },
    {
      "matchManagers": ["swift"],
      "groupName": "Swift packages"
    },
    {
      "matchManagers": ["mise"],
      "groupName": "mise tools"
    },
    {
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "enabled": false
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["lua"],
      "allowedVersions": "<5.2"
    },
    {
      "description": "@types/node describes the runtime, so it tracks the Node these packages run on rather than the newest DefinitelyTyped release. Types from a later major describe APIs that are not there and hide ones that were removed, and tsc believes them either way. Raise the ceiling when the toolchain in mise.toml moves.",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25"
    },
    {
      "description": "Pi's extension loader swaps in the typebox it bundles, so pi-paste pins that exact version by hand and realigns it when Pi moves.",
      "matchPackageNames": ["typebox"],
      "enabled": false
    },
    {
      "description": "pi-paste tracks Pi releases as they ship, so Pi skips the minimum release age that holds back everything else, and each update raises the package.json floor to the Pi it was built against.",
      "matchPackageNames": ["@earendil-works/**"],
      "minimumReleaseAge": null,
      "rangeStrategy": "bump"
    }
  ]
}
