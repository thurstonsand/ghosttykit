{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:biomeVersions",
    ":configMigration",
    ":maintainLockFilesWeekly",
    "security:minimumReleaseAgeNpm",
    "abandonments:recommended",
    ":enableVulnerabilityAlertsWithAdditionalLabel(security)"
  ],
  "ignorePaths": ["sdk/lua/.github/workflows/**", "nvim/.github/workflows/**"],
  "dependencyDashboard": true,
  "timezone": "America/New_York",
  "labels": ["dependencies"],
  "schedule": ["* * * * 1"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "Go modules"
    },
    {
      "matchManagers": ["npm"],
      "groupName": "npm packages"
    },
    {
      "matchManagers": ["swift"],
      "groupName": "Swift packages"
    },
    {
      "matchManagers": ["mise"],
      "groupName": "mise tools"
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["lua"],
      "allowedVersions": "<5.2"
    },
    {
      "description": "@types/node describes the runtime, so it tracks the Node these packages run on rather than the newest DefinitelyTyped release. Types from a later major describe APIs that are not there and hide ones that were removed, and tsc believes them either way. Raise the ceiling when the toolchain in mise.toml moves.",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25"
    }
  ]
}
