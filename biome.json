{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**/*.md", "!!**/biome.json"]
  },
  "markdown": {
    "parser": {
      "frontmatter": true
    }
  },
  "formatter": {
    "indentStyle": "space"
  }
}
