if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash)"
  mise install
fi

if command -v just >/dev/null 2>&1; then
  if [ ! -d .luals/addons/busted ] || [ ! -d .luals/addons/luassert ] || [ ! -e .luals/nvim-runtime ]; then
    just install-deps-lua
  fi

  if [ ! -d .luarocks/lib/luarocks/rocks-5.1/ghosttykit.nvim ]; then
    just install-deps-nvim
  fi
fi
