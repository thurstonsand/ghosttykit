eval "$(mise activate bash)"
mise install --quiet

watch_file mise.toml justfile scripts/ensure-node-deps.sh scripts/ensure-lua-deps.sh
watch_file sdk/lua/justfile sdk/lua/ghosttykit-scm-1.rockspec
watch_file nvim/justfile nvim/ghosttykit.nvim-scm-1.rockspec
watch_file sdk/ts/justfile sdk/ts/package.json sdk/ts/package-lock.json
watch_file pi/pi-paste/justfile pi/pi-paste/package.json pi/pi-paste/package-lock.json
just --quiet ensure-deps
