#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repo_root}"

run_step() {
  local name="$1"
  shift
  local start="${SECONDS}"

  printf '\n==> %s\n' "${name}"
  "$@"
  printf '<== %s (%ss)\n' "${name}" "$((SECONDS - start))"
}

install_system_packages() {
  if dpkg-query -W -f='${Status}' cmake 2>/dev/null | grep -q '^install ok installed$'; then
    return
  fi

  local apt=(apt-get)
  if ((EUID != 0)); then
    apt=(sudo apt-get)
  fi

  "${apt[@]}" update -qq
  "${apt[@]}" install -y --no-install-recommends cmake
}

install_mise() {
  if command -v mise >/dev/null 2>&1; then
    return
  fi

  curl -fsSL https://mise.run | sh
}

configure_mise_path() {
  local profile="${HOME}/.bash_profile"
  local marker='# GhosttyKit mise shims'

  touch "${profile}"
  if grep -Fqx "${marker}" "${profile}"; then
    return
  fi

  cat >>"${profile}" <<'EOF'

# GhosttyKit mise shims
case ":${PATH}:" in
  *":${HOME}/.local/share/mise/shims:"*) ;;
  *) export PATH="${HOME}/.local/share/mise/shims:${PATH}" ;;
esac
EOF
}

install_tools() {
  # Named rather than a bare `mise install` because the root config also pins the
  # Swift tools, which have no Linux build. Renovate is likewise absent: it is
  # scoped to the renovate tasks and installs on their first run.
  local tools=(
    actionlint
    go
    gofumpt
    golangci-lint
    hk
    lua
    lua-language-server
    markdownlint-cli2
    neovim
    node
    npm:prettier
    stylua
  )

  # Every component config has to be trusted, not just the root: tasks address as
  # //sdk/go:test and mise reads the config that owns them.
  mise trust --all
  mise install --yes --jobs 8 "${tools[@]}"
}

install_dependencies() {
  # bootstrap depends on every deps:* task and installs the git hooks. mise runs
  # the dependency tasks in parallel and skips the ones whose sources are
  # unchanged, which is what the hand-rolled background jobs here used to do.
  mise run bootstrap
}

run_step 'system packages' install_system_packages
run_step 'mise' install_mise
configure_mise_path
export PATH="${HOME}/.local/share/mise/shims:${HOME}/.local/bin:${PATH}"
run_step 'portable toolchain' install_tools
run_step 'project dependencies' install_dependencies

printf '\nOrb setup complete. Swift checks remain macOS-only.\n'
