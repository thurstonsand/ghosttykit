set shell := ["bash", "-euo", "pipefail", "-c"]

_default:
    just --list

fmt:
    golangci-lint fmt

lint:
    golangci-lint run ./...

test:
    go test ./...

integration-test:
    go test -tags=integration ./...

typecheck: test

check: fmt lint test

update-deps:
    go get -u -t ./...
    go mod tidy
