set shell := ["bash", "-euo", "pipefail", "-c"]

_default:
    just --list

fmt:
    golangci-lint fmt

fmt-check:
    diff="$(golangci-lint fmt --diff)"; printf '%s' "$diff"; test -z "$diff"

lint:
    golangci-lint run ./...

test:
    go test ./...

integration-test:
    go test -tags=integration ./...

check: fmt lint test

update-deps:
    go get -u -t ./...
    go mod tidy
