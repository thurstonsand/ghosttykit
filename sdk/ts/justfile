set shell := ["bash", "-euo", "pipefail", "-c"]

_default:
    just --list

fmt:
    npm run fmt

fmt-check:
    npx --no-install biome format .

lint:
    npm run lint

typecheck:
    npm run typecheck

test:
    npm run test

build:
    npm run build

check:
    npm run check

install-deps:
    npm install
