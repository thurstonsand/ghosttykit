set shell := ["bash", "-euo", "pipefail", "-c"]

binary := "gty"
install_dir := env_var_or_default("HOME", ".") + "/.local/bin"

_default:
    just --list

fmt:
    golangci-lint fmt

fmt-check:
    diff="$(golangci-lint fmt --diff)"; printf '%s' "$diff"; test -z "$diff"

lint:
    golangci-lint run ./...

test:
    go test ./...

check: fmt lint test

build:
    go build -o {{binary}} .

install:
    mkdir -p {{install_dir}}
    go build -o {{install_dir}}/{{binary}} .

update-deps:
    go get -u -t ./...
    go mod tidy
